# ==============================================================================
# Local Developer Sandbox Template (Windows / macOS / Linux)
# Copy to .env.dev (git-ignored) and use with docker-compose.dev.yml
# ==============================================================================

# --- Sandbox Mode & Browser Dev-Auth ---
APP_ENV=local_dev
DEBUG=True
DEV_AUTH_BYPASS=True
DEV_USER_ID=9990001

# --- Dedicated Test Telegram Bot (@BotFather) ---
BOT_TOKEN=YOUR_TEST_BOT_TOKEN
BOT_USERNAME=your_test_bot_username
WEBAPP_SHORT_NAME=game
USE_POLLING=True
WEBHOOK_URL=

# Set to http://localhost:8000 for local browser testing,
# or replace with https://<random>.trycloudflare.com when using the tunnel profile
WEBAPP_URL=http://localhost:8000

# --- Platform Admin Bootstrap ---
SYSTEM_OWNER_ID=9990001
ADMIN_IDS=[9990001]
INITIAL_CHATS=[{"id": -1009990001, "title": "Dev Sandbox Football Club"}]

# --- Local Sandbox PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev_postgres_password
POSTGRES_DB=sports_dev
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- Local Sandbox Redis (Logical DB Isolation) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=dev_redis_password
REDIS_FSM_DB=0
REDIS_CACHE_DB=1
REDIS_STREAM_DB=2

# --- Host Ports (Offset from default ports to prevent local collisions) ---
DEV_APP_PORT=8000
DEV_DB_PORT=5433
DEV_REDIS_PORT=6380
