# ==============================================================================
# Enterprise Sports & Team Logistics Platform — Production Environment Template
# Copy to .env and populate secrets before launching docker compose.
# ==============================================================================

# --- Runtime Profile ---
APP_ENV=production
DEBUG=False

# --- Telegram Bot & Mini App ---
BOT_TOKEN=
BOT_USERNAME=your_bot_username
WEBAPP_SHORT_NAME=game
WEBAPP_URL=https://app.example.com
WEBHOOK_URL=https://app.example.com/api/webhook
USE_POLLING=False

# --- Platform Governance, Localization & Access Control ---
SYSTEM_OWNER_ID=
ADMIN_IDS=[]
ALLOWED_USERS=[]
INITIAL_CHATS=[]
DEFAULT_LOCALE=en
DEFAULT_CURRENCY=CZK
DEFAULT_TIMEZONE=Europe/Prague
REGISTRATION_MODE=open_saas

# --- PostgreSQL 15+ ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=sports_platform
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=8

# --- Redis 7+ (Logical DB Isolation) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_FSM_DB=0
REDIS_CACHE_DB=1
REDIS_STREAM_DB=2

# --- Host Port Mappings ---
APP_PORT=8000

# --- Optional Off-Site 3-2-1 Backup Target (S3 / Cloudflare R2 / MinIO) ---
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6
BACKUP_AGE_RECIPIENT=
BACKUP_S3_URI=
BACKUP_S3_ENDPOINT=
